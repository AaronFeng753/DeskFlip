<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DeskFlip</RootNamespace>
    <AssemblyName>DeskFlip</AssemblyName>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>DeskFlip</Company>
    <Product>DeskFlip</Product>
    <Description>Switch virtual desktops by rubbing the left/right screen edges with the mouse.</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <ApplicationIcon>Assets\tray.ico</ApplicationIcon>
    <!-- Size: only ship our two UI languages (strips framework satellite assemblies
         for every other culture from the self-contained bundle). -->
    <SatelliteResourceLanguages>en;zh-CN</SatelliteResourceLanguages>
    <!-- NOTE: InvariantGlobalization was tried and reverted — WPF text rendering
         (XmlLanguage.GetSpecificCulture) requires ICU culture data and crashes without it. -->
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\tray.ico" />
    <Resource Include="Assets\tray-gray.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
  </ItemGroup>

</Project>
