<Window x:Class="DeskFlip.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="920" MinWidth="700" MinHeight="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="GestureHelpText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="GesturePanel"/>
                <StackPanel x:Name="BehaviorPanel" Grid.Column="2"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="ResetButton" Padding="12,4"/>
            <Button x:Name="MinimizeButton" Margin="8,0,0,0" Padding="12,4"/>
            <Button x:Name="ExitButton" Margin="8,0,0,0" Padding="12,4"/>
            <Button x:Name="OpenDataFolderButton" Margin="8,0,0,0" Padding="12,4"/>
            <Button x:Name="GitHubButton" Margin="8,0,0,0" Padding="12,4"/>
            <Button x:Name="AboutButton" Margin="8,0,0,0" Padding="12,4"/>
        </StackPanel>

        <Button x:Name="PromoButton" Grid.Row="3" Margin="0,12,0,0" Padding="12,8"
                HorizontalContentAlignment="Center"/>

        <TextBlock x:Name="AttributionText" Grid.Row="4" Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="0,10,0,0"/>
    </Grid>
</Window>
